DATABASE_URL=sqlite:///./nexusai.db
MIGRATION_DATABASE_URL=
# Set only in a one-off `python -m app.migrate` job for production.
RLS_ENFORCEMENT=false
PRODUCTION_MODE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
TELEGRAM_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
TELEGRAM_TTS_MODEL=gemini-3.8-flash-lite-tts
CORS_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_KEY=
GOOGLE_AUTH_ALLOWED_EMAIL=
SESSION_SECRET=
SESSION_COOKIE_SAMESITE=lax
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/integrations/linkedin/callback
LINKEDIN_API_VERSION=202609
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/integrations/instagram/callback
INSTAGRAM_API_VERSION=v26.0
WEB_URL=http://localhost:3000
# Required in production. This proxy must block private, loopback, link-local,
# multicast, reserved, and metadata IP ranges after DNS resolution.
PUBLIC_EGRESS_PROXY=
