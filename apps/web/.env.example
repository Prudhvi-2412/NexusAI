# NexusAI Web Application Environment Variables
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_FREE_TIER_DEMO=false
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Vercel production: use NEXT_PUBLIC_API_URL=/api/v1 and set this HTTPS origin
# to the Render API so Next.js can proxy API and OAuth callback traffic same-origin.
# NEXUS_API_ORIGIN=https://your-api.onrender.com
