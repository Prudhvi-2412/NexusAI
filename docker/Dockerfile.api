# NexusAI FastAPI image for staging and production.
FROM python:3.11-slim@sha256:b7a9e5f6a93d6d4a31f129bbd4bdee69efccb6ded0fb230d78aafaf37af98377

WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Install wheel-only Python packages, then Chromium and its runtime libraries.
COPY apps/api/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir --only-binary=:all: -r requirements.lock
RUN python -m playwright install --with-deps chromium
RUN apt-get update && apt-get install -y --no-install-recommends squid \
    && rm -rf /var/lib/apt/lists/*

# Copy backend application
COPY apps/api /app
COPY docker/squid.conf /etc/squid/squid.conf
COPY docker/proxy_supervisor.py /app/proxy_supervisor.py
COPY docker/verify_egress_proxy.py /app/verify_egress_proxy.py

RUN groupadd --system nexusai && useradd --system --gid nexusai --home-dir /home/nexusai --create-home nexusai \
    && mkdir -p /var/spool/squid /var/log/squid \
    && chown -R nexusai:nexusai /app /var/spool/squid /var/log/squid \
    && squid -k parse -f /etc/squid/squid.conf

USER nexusai

EXPOSE 8000

CMD ["python", "/app/proxy_supervisor.py"]
