# Docker Environment Configuration Example
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_secret
POSTGRES_DB=nexusai

REDIS_PORT=6379

NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API key for real Gemini chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_KEY=
GOOGLE_AUTH_ALLOWED_EMAIL=
SESSION_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback

# Optional shared MCP connectors (JSON array; see docs/MCP_CONNECTORS.md)
MCP_SERVERS_JSON=[]

# Optional shared Telegram bot. Users authorize their own account with a
# short-lived one-time code generated in Connections.
TELEGRAM_BOT_TOKEN=
