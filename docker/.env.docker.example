# Docker Environment Configuration Example
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_secret
POSTGRES_DB=nexusai

REDIS_PORT=6379

NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API key for real Gemini chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
TELEGRAM_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
TELEGRAM_TTS_MODEL=gemini-3.8-flash-lite-tts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_KEY=
GOOGLE_AUTH_ALLOWED_EMAIL=
SESSION_SECRET=
# When enabling database RLS, DATABASE_URL must use the least-privilege
# nexusai_app role. Keep this migration-only owner URL private and never use it
# for API traffic. Run `python -m app.migrate` in a separate job, apply the RLS
# SQL, then remove this URL from the production API service environment.
MIGRATION_DATABASE_URL=
RLS_ENFORCEMENT=false
PRODUCTION_MODE=false
FREE_TIER_DEMO_MODE=false
SESSION_COOKIE_SAMESITE=lax
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/integrations/linkedin/callback
LINKEDIN_API_VERSION=202609
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/integrations/instagram/callback
INSTAGRAM_API_VERSION=v26.0

# Optional shared MCP connectors (JSON array; see docs/MCP_CONNECTORS.md)
MCP_SERVERS_JSON=[]
# Required when PRODUCTION_MODE=true; proxy ACL must block private, loopback,
# link-local, multicast, reserved, and metadata ranges after DNS resolution.
PUBLIC_EGRESS_PROXY=http://127.0.0.1:3128

# Optional shared Telegram bot. Users authorize their own account with a
# short-lived one-time code generated in Connections.
TELEGRAM_BOT_TOKEN=
